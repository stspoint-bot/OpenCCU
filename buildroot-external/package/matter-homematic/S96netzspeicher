#!/bin/sh
# shellcheck shell=dash disable=SC2169
#
# Netzspeicher (WD/NAS per SMB) fest im System: einhaengen, ueberwachen, bei Haengern neu einhaengen.
# Konfiguration (von der Matter-Oberflaeche geschrieben, ueberlebt Image-Updates):
#   /usr/local/etc/netzspeicher/netzspeicher.conf          HOST=..  SHARE=..  [VERS="3.1.1 3.0"]  [SEAL=1|0]  [ALLOW_LEGACY=0|1]  [DOMAIN=..]
#   /usr/local/etc/netzspeicher/credentials                 username=..  password=..  (Modus 0600, mount.cifs-Format)
# Sicherheit (Standard): nur SMB 3.1.1 / 3.0 (kein SMB 2.1 ohne ALLOW_LEGACY=1, kein SMB 1), Verschluesselung (seal) und Signierung (sign)
# Pflicht, nosuid/nodev/noexec. Wird das nicht ausgehandelt, schlaegt das Einhaengen fehl (Status "nicht verbunden", Grund in
# ${RUN}/status-detail) statt stillschweigend unverschluesselt zu laufen. Der Speicher ist austauschbar: nur HOST/SHARE/Zugangsdaten
# aendern (jedes SMB3-faehige NAS, Windows-Freigabe oder Samba-Server).
# Nichts Boot-Kritisches liegt auf dem Netzspeicher; ohne Konfiguration oder bei ausgeschaltetem NAS passiert nichts.
# Aufrufe: prepare | start | stop | restart | remount | check | watch | status | info | selftest
#
# Verzeichnis enthaelt eine Datei ".nobackup": createBackup.sh (tar --exclude-tag=.nobackup) nimmt den Inhalt NICHT in die
# CCU-Sicherung (.sbk) auf, also auch nicht in Kopien ausser Haus. Aufruf "prepare" legt Verzeichnis (0700) und Marker an.
DIR=${NETZSPEICHER_DIR:-/usr/local/etc/netzspeicher}
CONF=${NETZSPEICHER_CONF:-${DIR}/netzspeicher.conf}
CRED=${NETZSPEICHER_CRED:-${DIR}/credentials}
MP=${NETZSPEICHER_MP:-/media/ccu3-netzspeicher}
RUN=${NETZSPEICHER_RUN:-/var/run/netzspeicher}
PAUSE=${RUN}/pause-bis        # Auth-Fehler: 6 Stunden nicht erneut versuchen (Sperren des Kontos vermeiden)
LAST=${RUN}/letzter-versuch   # sonst frueheste Wiederholung nach 5 Minuten (Backoff)
DETAIL=${RUN}/status-detail   # ok SMB <Version> seal=<0|1>  oder  fehler: <Meldung>
AUTH_PAUSE=21600
RETRY_GAP=300

log() { logger -t netzspeicher "$*" 2>/dev/null; [ -n "$NETZSPEICHER_DEBUG" ] && echo "netzspeicher: $*"; return 0; }
configured() { [ -f "$CONF" ] && [ -f "$CRED" ]; }
now() { cut -d. -f1 /proc/uptime; }   # Sekunden seit Start (monoton, unabhaengig von der Uhr)
mounts() { grep -c " ${MP} cifs " /proc/mounts 2>/dev/null; }
responsive() { timeout 10 stat -f "$MP" >/dev/null 2>&1; }
paused() { [ -f "$PAUSE" ] && [ "$(now)" -lt "$(cat "$PAUSE" 2>/dev/null || echo 0)" ]; }

prepare() { mkdir -p "$DIR" && chmod 0700 "$DIR" && : > "${DIR}/.nobackup" && chmod 0600 "${DIR}/.nobackup"; }

umount_all() { n=0; while [ "$(mounts)" -gt 0 ] && [ $n -lt 20 ]; do umount -l "$MP" 2>/dev/null; n=$((n + 1)); done; }

# Konfiguration einlesen OHNE sie als Shell-Code auszufuehren (keine Befehls-/Optionseinschleusung ueber HOST, SHARE, DOMAIN ...).
# Nur bekannte Schluessel, nur erlaubte Zeichen/Werte; sonst Abbruch mit Meldung.
load_conf() {
  HOST=; SHARE=; VERS=; SEAL=; ALLOW_LEGACY=; DOMAIN=
  while IFS='=' read -r k v || [ -n "$k" ]; do
    v=${v%"$(printf '\r')"}; v=${v#\"}; v=${v%\"}
    case "$k" in
      HOST) HOST=$v ;; SHARE) SHARE=$v ;; VERS) VERS=$v ;; SEAL) SEAL=$v ;; ALLOW_LEGACY) ALLOW_LEGACY=$v ;; DOMAIN) DOMAIN=$v ;;
    esac
  done < "$CONF"
  case "$HOST" in ""|*[!A-Za-z0-9._:-]*) log "HOST fehlt oder enthaelt ungueltige Zeichen"; return 1;; esac
  case "$SHARE" in ""|*[!A-Za-z0-9._\$-]*) log "SHARE fehlt oder enthaelt ungueltige Zeichen"; return 1;; esac
  case "$DOMAIN" in *[!A-Za-z0-9._-]*) log "DOMAIN enthaelt ungueltige Zeichen"; return 1;; esac
  case "${SEAL:-1}" in 0|1) ;; *) log "SEAL muss 0 oder 1 sein"; return 1;; esac
  case "${ALLOW_LEGACY:-0}" in 0|1) ;; *) log "ALLOW_LEGACY muss 0 oder 1 sein"; return 1;; esac
  for t in $VERS; do case "$t" in 3.1.1|3.0|2.1) ;; *) log "VERS: unbekannte Version $t"; return 1;; esac; done
  return 0
}

mount_once() {
  # Ohne Konfiguration (z. B. nach dem Abschalten in der Oberflaeche): aushaengen und fertig.
  configured || { umount_all; return 0; }
  prepare
  chmod 0600 "$CRED" "$CONF" 2>/dev/null
  load_conf || { mkdir -p "$RUN"; echo "fehler: ungueltige Konfiguration ($CONF)" > "$DETAIL"; return 1; }
  mkdir -p "$RUN" "$MP"
  now > "$LAST"
  umount_all
  OPTS="credentials=${CRED},soft,noserverino,nounix,file_mode=0600,dir_mode=0700,echo_interval=10,actimeo=30,nosuid,nodev,noexec,sign"
  [ "${SEAL:-1}" = "1" ] && OPTS="${OPTS},seal"
  [ -n "$DOMAIN" ] && OPTS="${OPTS},domain=${DOMAIN}"
  VL="${VERS:-3.1.1 3.0}"
  [ "${ALLOW_LEGACY:-0}" = "1" ] && VL="${VL} 2.1"
  rc=1
  for v in $VL; do
    out=$(timeout 40 mount -t cifs "//${HOST}/${SHARE}" "$MP" -o "${OPTS},vers=${v}" 2>&1); rc=$?
    if [ $rc -eq 0 ]; then
      log "eingehaengt (SMB ${v}, seal=${SEAL:-1})"
      echo "ok SMB ${v} seal=${SEAL:-1}" > "$DETAIL"
      return 0
    fi
    case "$out" in *"error(13)"*|*"Permission denied"*|*"LOGON_FAILURE"*) break;; esac
  done
  case "$out" in
    *"error(13)"*|*"Permission denied"*|*"LOGON_FAILURE"*)
      echo $(( $(now) + AUTH_PAUSE )) > "$PAUSE"; log "Anmeldung abgelehnt - 6 h Pause (Zugangsdaten pruefen)";;
    *) log "mount fehlgeschlagen: $(echo "$out" | tail -n 1)";;
  esac
  echo "fehler: $(echo "$out" | tail -n 1)" > "$DETAIL"
  return 1
}

check() {
  configured || return 0
  mkdir -p "$RUN"
  paused && return 0
  unlink "$PAUSE" 2>/dev/null   # abgelaufene Pause aufraeumen
  if [ "$(mounts)" -eq 1 ] && responsive; then return 0; fi
  # nicht eingehaengt, doppelt eingehaengt oder haengt: hoechstens alle 5 Minuten neu versuchen
  [ -f "$LAST" ] && [ "$(( $(now) - $(cat "$LAST" 2>/dev/null || echo 0) ))" -lt "$RETRY_GAP" ] && return 0
  now > "$LAST"
  [ "$(mounts)" -gt 0 ] && log "Freigabe haengt/doppelt - neu einhaengen"
  mount_once
  return 0
}

# Kleiner Funktionstest (1 winzige Datei): schreiben, zuruecklesen, vergleichen, wieder loeschen.
selftest() {
  [ "$(mounts)" -eq 1 ] && responsive || { echo "nicht verbunden"; return 1; }
  f="${MP}/.selftest-$$"
  p="$(now)-$$"
  if echo "$p" > "$f" && [ "$(cat "$f")" = "$p" ]; then
    unlink "$f" 2>/dev/null
    echo "ok (schreiben/lesen/loeschen)"
    return 0
  fi
  unlink "$f" 2>/dev/null
  echo "FEHLER beim Schreib-/Lesetest"
  return 1
}

case "$1" in
  start)   ( unlink "$PAUSE" 2>/dev/null; unlink "$LAST" 2>/dev/null; check ) >/dev/null 2>&1 & ;;   # im Hintergrund: der Start wartet nie auf das NAS
  stop)    umount_all ;;
  restart|remount) unlink "$PAUSE" 2>/dev/null; unlink "$LAST" 2>/dev/null; mkdir -p "$RUN"; mount_once; exit $? ;;
  check)   check ;;
  prepare) prepare ;;
  info)    grep -iE "Dialect|Encryption|SecMode" /proc/fs/cifs/DebugData 2>/dev/null; cat "$DETAIL" 2>/dev/null ;;
  selftest) selftest; exit $? ;;
  watch)   # fuer monit: erst ggf. neu einhaengen, Rueckgabe 0 = in Ordnung oder nicht konfiguriert/pausiert, 1 = konfiguriert aber nicht verbunden
    check
    configured || exit 0
    paused && exit 0
    [ "$(mounts)" -eq 1 ] && responsive && exit 0
    exit 1 ;;
  status)
    configured || { echo "nicht konfiguriert"; exit 3; }
    paused && { echo "pausiert (Anmeldung abgelehnt)"; exit 2; }
    if [ "$(mounts)" -eq 1 ] && responsive; then echo "verbunden"; exit 0; fi
    echo "nicht verbunden"; exit 1;;
  *) echo "Usage: $0 {prepare|start|stop|restart|remount|check|watch|status|info|selftest}" >&2; exit 1;;
esac
exit 0
