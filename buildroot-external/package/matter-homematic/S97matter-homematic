#!/bin/sh
# shellcheck shell=dash disable=SC2169
#
# Startet/stoppt die Matter-Homematic-Bridge (CCU3-neu). Teil des Systemabbilds:
# Programm read-only unter /usr/lib/matter-homematic, Daten unter /usr/local/etc/config/addons/matter-homematic.
# Reihenfolge: nach rfd/HMIPServer/ReGaHss (S61/S62/S70), vor S98StartAddons.
#
# Updates ohne neues Abbild: Liegt unter /usr/local/addons/matter-homematic (SD, vom normalen Paket-Update beschrieben) eine NEUERE
# Version als im Abbild, wird diese gestartet. Laesst sie sich nicht starten, faellt der Start auf die Version im Abbild zurueck.
ID=matter-homematic
IMG_DIR=/usr/lib/${ID}
ADDON_DIR=/usr/local/addons/${ID}
DATA_DIR=/usr/local/etc/config/addons/${ID}
NODE=/usr/bin/node
PIDFILE=/var/run/${ID}.pid
LEGACY=/usr/local/etc/config/rc.d/${ID}
LEGACY_MONIT=/usr/local/etc/monit-${ID}.cfg
export MATTER_HOMEMATIC_DATA_DIR="${DATA_DIR}"
export HOME="${DATA_DIR}"
export PATH="/usr/bin:/bin:/usr/sbin:/sbin"

# Versionsnummer ohne Zusatz ("0.21.95-ccu3-neu" -> "0.21.95")
ver() { v=$(cat "$1/VERSION" 2>/dev/null); echo "${v%%-*}"; }
# neuer A B: Exitcode 0, wenn Version A echt neuer ist als B (nur Ziffern und Punkte)
neuer() {
  case "$1$2" in ""|*[!0-9.]*) return 1;; esac
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | tail -n 1)" = "$1" ]
}
# waehlt die zu startende Programmversion (Ausgabe: Verzeichnis)
choose_dir() {
  if [ -f "${ADDON_DIR}/dist/index.js" ] && neuer "$(ver "$ADDON_DIR")" "$(ver "$IMG_DIR")"; then echo "$ADDON_DIR"; else echo "$IMG_DIR"; fi
}

running() {
  [ -f "$PIDFILE" ] || return 1
  PID=$(cat "$PIDFILE")
  case "$PID" in ""|*[!0-9]*) return 1;; esac
  kill -0 "$PID" 2>/dev/null || return 1
  tr '\000' '\n' < "/proc/$PID/cmdline" 2>/dev/null | grep -Fxq -e "${IMG_DIR}/dist/index.js" -e "${ADDON_DIR}/dist/index.js"
}

# Altes Add-on (rc.d-Skript und monit-Regel aus /usr/local, wuerden eine zweite Bridge auf denselben Ports starten bzw. monit wegen doppeltem
# Dienstnamen "matter-homematic" am Start hindern): beim Start beiseitelegen. Die Bridge gehoert dem Abbild (S97 + /etc/monit.d), nicht dem Add-on.
# Laeuft vor S98StartAddons und vor monit, deshalb greifen beide Aenderungen schon beim ersten Boot nach einer Wiederherstellung.
migrate_legacy() {
  [ -f "$LEGACY" ] || [ -f "$LEGACY_MONIT" ] || return 0
  mkdir -p "${DATA_DIR}"
  if [ -f "$LEGACY" ]; then
    mv -f "$LEGACY" "${DATA_DIR}/rc.d-matter-homematic.alt-vor-image" 2>/dev/null || true
    logger -t ${ID} "altes Add-on-Startskript beiseitegelegt (jetzt Teil des Systemabbilds)" 2>/dev/null || true
  fi
  if [ -f "$LEGACY_MONIT" ]; then
    mv -f "$LEGACY_MONIT" "${DATA_DIR}/monit-matter-homematic.cfg.alt-vor-image" 2>/dev/null || true
    logger -t ${ID} "alte monit-Regel beiseitegelegt (jetzt /etc/monit.d)" 2>/dev/null || true
  fi
}

# Wartet (hoechstens 120 s), bis die Funkdienste (BidCos-RF 32001, HmIP-RF 32010) auf eine XML-RPC-Anfrage antworten. Sonst meldet sich die
# Bridge zu frueh an ("CCU not ready yet"), und es kommen nach einem CCU-Start keine Ereignisse an. Danach startet die Bridge in jedem Fall.
wait_funk() {
  n=0
  while [ "$n" -lt 40 ]; do
    ok=0
    for p in 32001 32010; do
      r=$(wget -q -T3 -O - --header='Content-Type: text/xml' --post-data='<?xml version="1.0"?><methodCall><methodName>system.listMethods</methodName><params/></methodCall>' "http://localhost:${p}/" 2>/dev/null | head -c 300)
      case "$r" in *methodResponse*) ok=$((ok + 1));; esac
    done
    [ "$ok" -eq 2 ] && return 0
    sleep 3; n=$((n + 1))
  done
  logger -t ${ID} "Funkdienste nach 120 s nicht bereit - Bridge startet trotzdem" 2>/dev/null || true
  return 1
}

# Startet die Bridge aus Verzeichnis $1 und wartet auf Bereitschaft. 0 = bereit.
start_from() {
  DIR=$1; APP="${DIR}/dist/index.js"
  [ -x "$NODE" ] && [ -f "$APP" ] || return 1
  rm -f "$PIDFILE"
  [ ! -f "${DATA_DIR}/startup.log" ] || mv -f "${DATA_DIR}/startup.log" "${DATA_DIR}/startup.previous.log"
  : > "${DATA_DIR}/startup.log"
  logger -t ${ID} "starting Matter bridge $(ver "$DIR") from ${DIR}" 2>/dev/null || true
  start-stop-daemon -S -b -m -p "$PIDFILE" -x "$NODE" -- "$APP" >>"${DATA_DIR}/startup.log" 2>&1 || return 1
  if ! "$NODE" "${DIR}/dist/healthcheck.js" "${DATA_DIR}/config.json" 120 --web-ready; then
    stop || true
    logger -t ${ID} "service readiness failed (${DIR}); see ${DATA_DIR}/startup.log" 2>/dev/null || true
    return 1
  fi
  return 0
}

# Rueckgabe von start(): 0 = gewaehlte Version laeuft und ist bereit, 3 = gewaehlte Version (aus /usr/local/addons) liess sich nicht starten,
# stattdessen laeuft die Version im Abbild (Rueckfall), 1 = es laeuft keine Bridge.
start() {
  [ -x "$NODE" ] || { echo "FAILED (node fehlt)"; return 1; }
  migrate_legacy
  if running; then return 0; fi
  mkdir -p "${DATA_DIR}"
  chmod 0700 "${DATA_DIR}" 2>/dev/null   # Datenordner enthaelt Konfiguration/Geheimnisse: nur root
  cd "${DATA_DIR}" || return 1
  wait_funk
  WANT=$(choose_dir)
  start_from "$WANT" && return 0
  if [ "$WANT" != "$IMG_DIR" ]; then
    logger -t ${ID} "Version in ${WANT} liess sich nicht starten - Rueckfall auf die Version im Abbild" 2>/dev/null || true
    start_from "$IMG_DIR" && return 3
  fi
  return 1
}

stop() {
  if running; then
    PID=$(cat "$PIDFILE")
    kill -TERM "$PID" 2>/dev/null
    COUNT=0
    while running && [ "$COUNT" -lt 8 ]; do sleep 1; COUNT=$((COUNT + 1)); done
    if running; then
      kill -KILL "$PID" 2>/dev/null
      sleep 2
    fi
    running && return 1
  fi
  rm -f "$PIDFILE"
  return 0
}

case "$1" in
  start)   echo -n "Starting ${ID}: "; start; rc=$?; case $rc in 0) echo OK;; 3) echo "OK (Rueckfall auf Abbild-Version)";; *) echo FAILED;; esac; exit $rc ;;
  stop)    echo -n "Stopping ${ID}: "; stop && echo OK || { echo FAILED; exit 1; } ;;
  restart) stop || { echo "Stopping ${ID}: FAILED"; exit 1; }; echo -n "Starting ${ID}: "; start; rc=$?; case $rc in 0) echo OK;; 3) echo "OK (Rueckfall auf Abbild-Version)";; *) echo FAILED;; esac; exit $rc ;;
  status)  if running; then echo "${ID} is running (PID $(cat "$PIDFILE"))"; else echo "${ID} is stopped"; exit 1; fi ;;
  which)   choose_dir ;;
  *)       echo "Usage: $0 {start|stop|restart|status|which}" >&2; exit 1 ;;
esac
exit 0
