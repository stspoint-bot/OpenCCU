-convertMin2Hour = function(valMin) {
-  var min = parseInt(valMin),
-  hours = Math.floor(valMin / 60),
-  minutes = valMin % 60;
-
-  hours = (isNaN(hours)) ? 0 : hours;
-  minutes = (isNaN(minutes)) ? 0 : minutes;
-
-  return hours + ' h : ' + ((minutes <= 9) ? "0"+minutes+" m" : minutes+" m");
-};
