-
-round = function(x, n)
-{ 
-  // x = Fließkommazahl, n = gewünschte Nachkommastellen
-  if (!n) n = 2; //wenn n fehlt wird n = 2
-  if (n < 1 || n > 14) return false;
-  var e = Math.pow(10, n);
-  var k = (Math.round(x * e) / e).toString();
-  if (k.indexOf('.') == -1) k += '.';
-  k += e.toString().substring(1);
-  return k.substring(0, k.indexOf('.') + n+1);
-};
