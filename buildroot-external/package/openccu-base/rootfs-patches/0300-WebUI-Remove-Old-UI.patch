-roundValue05 = function(val) {
-  var intVal = Math.floor(val);
-  if (val - intVal > 0.5) {
-    return Math.ceil(val);
-  }
-
-  if (val - intVal == 0) {
-    return val;
-  }
-
-  return intVal + 0.5;
